		"@types/axios": "^0.14.4",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.1",
		"@types/mongoose": "^5.11.97",
		"axios": "^1.8.4",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"ethers": "^6.7.1",
		"express": "^4.21.2",
		"mongoose": "^8.13.1",
		"winston": "^3.10.0"
	},
	"devDependencies": {
		"@types/chai": "^5.2.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.5.7",
		"chai": "^5.2.0",
		"mocha": "^11.1.0",
		"nodemon": "^3.0.1",
		"ts-mocha": "^11.1.0",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.2.2"
	}
