{
	"name": "bscliquiditysniper",
	"version": "1.0.0",
	"description": "BSC Liquidity Sniper",
	"main": "index.js",
	"scripts": {
		"start": "ts-node src/index.ts",
		"dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
		"build": "tsc",
		"test": "mocha -r ts-node/register 'src/tests/**/*.test.ts'",
		"test:provider": "mocha -r ts-node/register src/tests/providerPool.test.ts --timeout 60000",
		"test:historical": "ts-node src/tests/historical.test.ts",
		"test:token": "mocha -r ts-node/register src/tests/tokenService.test.ts --timeout 60000"
	},
